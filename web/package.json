{
  "name": "balance-lab-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:demo": "pnpm typecheck && dotnet publish ../demo/BalanceLab.Demo.Wasm -c Release -o ../artifacts/demo-wasm && vite build --mode demo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p e2e-demo",
    "lint": "eslint .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "mutation": "stryker run",
    "e2e": "vite build && playwright test -c e2e",
    "e2e:demo": "pnpm build:demo && playwright test -c e2e-demo",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm arch && pnpm coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.2.9",
    "@fontsource-variable/inter": "5.2.8",
    "@microsoft/signalr": "10.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
